@page "/"
@rendermode InteractiveServer

<PageTitle>Geometry Dash Place</PageTitle>

@if (IsLoading)
{
    <main class="editor-page editor-state-page">
        <GeometryDashText Text="LOADING" Height="34" />
    </main>
}
else if (CurrentEvent is null)
{
    <main class="editor-page editor-state-page">
        <GeometryDashText Text="NO ACTIVE EVENT" Height="34" />
        <p>@(StatusMessage ?? "No event is currently open.")</p>
        @if (!IsAuthenticated)
        {
            <a class="google-login" href="/login/google">SIGN IN WITH GOOGLE</a>
        }
    </main>
}
else
{
    <CascadingValue Value="Editor">
        <CascadingValue Value="Actions">
            <CascadingValue Value="Cooldown">
                <main class="editor-page">
                    <EditorViewport />
                    <EditorToolbar />

                    @if (IsAuthenticated)
                    {
                        <CooldownDisplay />
                    }

                    <button type="button"
                            class="editor-menu-toggle"
                            aria-label="Toggle navigation"
                            aria-expanded="@IsAccountMenuOpen"
                            @onclick="ToggleAccountMenu">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>

                    @if (IsAccountMenuOpen)
                    {
                        <button type="button"
                                class="editor-menu-backdrop"
                                aria-label="Close navigation"
                                @onclick="CloseAccountMenu"></button>
                        <aside class="editor-account-panel" aria-label="Account and navigation">
                            <span class="account-menu-heading">
                                <GeometryDashText Text="MENU" Height="19" Gold="true" />
                            </span>
                            <span class="account-event-name">
                                <GeometryDashText Text="@CurrentEvent.Name" Height="15" />
                            </span>
                            <a class="account-action account-archive-action" href="/events">
                                <GeometryDashText Text="EVENTS" Height="14" />
                            </a>
                            @if (IsAdmin)
                            {
                                <a class="account-action account-admin-action" href="/admin">
                                    <GeometryDashText Text="ADMIN" Height="14" />
                                </a>
                            }
                            @if (IsAuthenticated)
                            {
                                <span class="account-user-name" title="@UserDisplayName">@UserDisplayName</span>
                                <a class="account-action" href="/logout" data-enhance-nav="false">
                                    <GeometryDashText Text="LOG OUT" Height="14" />
                                </a>
                            }
                            else
                            {
                                <a class="account-action" href="/login/google" data-enhance-nav="false">
                                    <GeometryDashText Text="SIGN IN" Height="14" />
                                </a>
                            }
                        </aside>
                    }

                    @if (!IsAuthenticated)
                    {
                        <div class="editor-auth-guard">
                            <GeometryDashText Text="SIGN IN TO BUILD" Height="30" />
                            <a class="google-login" href="/login/google" data-enhance-nav="false">GOOGLE</a>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <div class="editor-persistence-message" role="status">@StatusMessage</div>
                    }
                </main>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
}
