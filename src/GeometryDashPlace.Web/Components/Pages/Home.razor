@page "/"
@rendermode InteractiveServer

<PageTitle>Geometry Dash Place</PageTitle>

@if (IsLoading)
{
    <main class="editor-page editor-state-page">
        <GeometryDashText Text="LOADING" Height="34" />
    </main>
}
else if (CurrentEvent is null)
{
    <main class="editor-page editor-state-page">
        <GeometryDashText Text="NO ACTIVE EVENT" Height="34" />
        <p>@(StatusMessage ?? "No event is currently open.")</p>
        @if (!IsAuthenticated)
        {
            <a class="google-login" href="/login/google">SIGN IN WITH GOOGLE</a>
        }
    </main>
}
else
{
    <CascadingValue Value="Editor">
        <CascadingValue Value="Actions">
            <CascadingValue Value="Cooldown">
                <main class="editor-page">
                    <EditorViewport BackgroundTexturePath="@EnvironmentAssets.BackgroundPath(CurrentEvent.BackgroundKey)"
                                    GroundTexturePath="@EnvironmentAssets.GroundPath(CurrentEvent.GroundKey)" />
                    <EditorToolbar />

                    @if (IsAuthenticated)
                    {
                        <CooldownDisplay />
                    }

                    @if (!IsAuthenticated)
                    {
                        <div class="editor-auth-guard">
                            <GeometryDashText Text="SIGN IN TO BUILD" Height="30" />
                            <a class="google-login" href="/login/google" data-enhance-nav="false">GOOGLE</a>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <div class="editor-persistence-message" role="status">@StatusMessage</div>
                    }

                    @if (_pendingRecentPlacement is not null)
                    {
                        <div class="recent-overwrite-backdrop">
                            <section class="recent-overwrite-dialog"
                                     role="alertdialog"
                                     aria-modal="true"
                                     aria-labelledby="recent-overwrite-title">
                                <span id="recent-overwrite-title">
                                    <GeometryDashText Text="RECENT CHANGE" Height="25" Gold="true" />
                                </span>
                                <p>Another player placed an object on this cell less than 2 seconds ago.</p>
                                <p>Do you really want to replace it?</p>
                                <div class="recent-overwrite-actions">
                                    <button type="button"
                                            class="recent-overwrite-cancel"
                                            @onclick="CancelRecentOverwrite">
                                        <GeometryDashText Text="CANCEL" Height="15" />
                                    </button>
                                    <button type="button"
                                            class="recent-overwrite-confirm"
                                            disabled="@IsSaving"
                                            @onclick="ConfirmRecentOverwriteAsync">
                                        <GeometryDashText Text="PLACE ANYWAY" Height="15" />
                                    </button>
                                </div>
                            </section>
                        </div>
                    }
                </main>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
}
