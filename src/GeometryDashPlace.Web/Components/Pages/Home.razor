@page "/"
@rendermode InteractiveServer

<PageTitle>Geometry Dash Place</PageTitle>

@if (IsLoading)
{
    <main class="editor-page editor-state-page">
        <GeometryDashText Text="LOADING" Height="34" />
    </main>
}
else if (CurrentEvent is null)
{
    <main class="editor-page editor-state-page">
        <GeometryDashText Text="NO ACTIVE EVENT" Height="34" />
        <p>@(StatusMessage ?? "No event is currently open.")</p>
        @if (!IsAuthenticated)
        {
            <a class="google-login" href="/login/google">SIGN IN WITH GOOGLE</a>
        }
    </main>
}
else
{
    <CascadingValue Value="Editor">
        <CascadingValue Value="Actions">
            <main class="editor-page">
                <EditorViewport />
                <EditorToolbar />

                <aside class="editor-account-panel" aria-label="Account">
                    <span class="account-event-name">
                        <GeometryDashText Text="@CurrentEvent.Name" Height="15" />
                    </span>
                    @if (IsAuthenticated)
                    {
                        <span class="account-user-name" title="@UserDisplayName">@UserDisplayName</span>
                        <a class="account-action" href="/logout">
                            <GeometryDashText Text="LOG OUT" Height="14" />
                        </a>
                    }
                    else
                    {
                        <a class="account-action" href="/login/google">
                            <GeometryDashText Text="SIGN IN" Height="14" />
                        </a>
                    }
                </aside>

                @if (!IsAuthenticated)
                {
                    <div class="editor-auth-guard">
                        <GeometryDashText Text="SIGN IN TO BUILD" Height="30" />
                        <a class="google-login" href="/login/google">GOOGLE</a>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(StatusMessage))
                {
                    <div class="editor-persistence-message" role="status">@StatusMessage</div>
                }
            </main>
        </CascadingValue>
    </CascadingValue>
}
