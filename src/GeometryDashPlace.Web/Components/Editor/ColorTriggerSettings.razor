@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@using System.Globalization

<section class="color-trigger-settings"
         aria-label="Color trigger settings"
         hidden="@(!Editor.IsColorTriggerSelected)">
    <strong><GeometryDashText Text="COLOR TRIGGER" Height="16" /></strong>

    <div class="color-target-field">
        <span><GeometryDashText Text="TARGET" Height="11" /></span>
        <div class="color-target-options">
            <button class="@(Editor.ColorTarget == "background" ? "is-active" : null)"
                    type="button"
                    aria-pressed="@(Editor.ColorTarget == "background")"
                    @onclick="SelectBackground"><GeometryDashText Text="BG" Height="10" /></button>
            <button class="@(Editor.ColorTarget == "ground" ? "is-active" : null)"
                    type="button"
                    aria-pressed="@(Editor.ColorTarget == "ground")"
                    @onclick="SelectGround"><GeometryDashText Text="GROUND" Height="10" /></button>
        </div>
    </div>

    <div class="color-value-field">
        <span><GeometryDashText Text="COLOR" Height="11" /></span>

        <div class="gd-color-picker"
             @ref="_colorWheel"
             style="--picker-color: #ff0000; --selected-color: @Editor.ColorHex;">
            <div class="hue-wheel-surface"
                 data-color-wheel-hue
                 role="slider"
                 tabindex="0"
                 aria-label="Hue"
                 aria-valuemin="0"
                 aria-valuemax="359"
                 aria-valuenow="0">
                <img class="hue-wheel-image"
                     src="/assets/ui/color-picker/wheel/hue-wheel.png"
                     alt=""
                     draggable="false" />
                <img class="picker-handle hue-picker-handle"
                     data-color-wheel-hue-handle
                     src="/assets/ui/color-picker/wheel/selection-handle.png"
                     alt=""
                     draggable="false" />

                <div class="color-plane"
                     data-color-wheel-plane
                     role="application"
                     tabindex="0"
                     aria-label="Saturation and brightness">
                    <span class="color-plane-base" aria-hidden="true"></span>
                    <img class="color-plane-layer"
                         src="/assets/ui/color-picker/wheel/color-shading.png"
                         alt=""
                         draggable="false" />
                    <img class="color-plane-layer"
                         src="/assets/ui/color-picker/wheel/color-overlay.png"
                         alt=""
                         draggable="false" />
                    <img class="picker-handle color-picker-handle"
                         data-color-wheel-plane-handle
                         src="/assets/ui/color-picker/wheel/selection-handle.png"
                         alt=""
                         draggable="false" />
                </div>
            </div>
        </div>

        <div class="color-picker-readout">
            <span class="selected-color-swatch"
                  style="--selected-color: @Editor.ColorHex;"
                  aria-hidden="true"></span>
            <input class="color-hex-input @(Editor.IsColorHexInvalid ? "is-invalid" : null)"
                   type="text"
                   value="@Editor.ColorHex"
                   maxlength="7"
                   autocomplete="off"
                   spellcheck="false"
                   @oninput="HandleHexInput"
                   aria-label="Hex color code" />
        </div>

        <input @ref="_colorInput"
               type="hidden"
               value="@Editor.ColorHex"
               @oninput="HandleWheelInput" />
    </div>

    <label class="duration-field">
        <span><GeometryDashText Text="DURATION" Height="11" /></span>
        <input type="number"
               value="@Editor.ColorDuration.ToString(CultureInfo.InvariantCulture)"
               min="0"
               step="0.1"
               inputmode="decimal"
               @oninput="HandleDurationInput"
               aria-label="Color transition duration in seconds" />
        <small><GeometryDashText Text="SECOND(S)" Height="9" /></small>
    </label>
</section>

@code {
    private ElementReference _colorWheel;
    private ElementReference _colorInput;
    private IJSObjectReference? _module;

    [CascadingParameter]
    public required EditorSession Editor { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>(
                "import", "/js/editor/color-wheel-interop.js");
            await _module.InvokeVoidAsync("initialize", _colorWheel, _colorInput);
        }

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setColor", _colorWheel, Editor.ColorHex);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("dispose", _colorWheel);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void HandleWheelInput(ChangeEventArgs eventArgs) => Editor.SetColorHex(eventArgs.Value?.ToString());
    private void HandleHexInput(ChangeEventArgs eventArgs) => Editor.SetColorHex(eventArgs.Value?.ToString());
    private void HandleDurationInput(ChangeEventArgs eventArgs) => Editor.SetColorDuration(eventArgs.Value?.ToString());
    private void SelectBackground() => Editor.SetColorTarget("background");
    private void SelectGround() => Editor.SetColorTarget("ground");
}
