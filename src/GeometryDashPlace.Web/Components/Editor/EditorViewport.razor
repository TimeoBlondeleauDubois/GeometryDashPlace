@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<canvas class="editor-grid"
        @ref="_canvas"
        aria-label="Geometry Dash editor grid"
        tabindex="0"
        @onpointerdown="HandlePointerDown"
        @onpointermove="HandlePointerMove"
        @onpointerup="HandlePointerUp"
        @onpointercancel="HandlePointerUp"
        @onpointerleave="HandlePointerLeave"
        @onpointerdown:preventDefault="true"
        @onwheel="HandleWheel"
        @onwheel:preventDefault="true"></canvas>

<FreeRotationOverlay />
<ScaleOverlay />
<LevelTimeline />
<ZoomControls />
<EditorStatus />

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<EditorViewport>? _reference;
    private bool _disposed;
    private double _canvasLeft;
    private double _canvasTop;

    [CascadingParameter]
    public required EditorSession Editor { get; set; }

    protected override void OnInitialized()
    {
        Editor.Changed += HandleEditorChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _reference = DotNetObjectReference.Create(this);
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/editor/editor-canvas.js");
        await _module.InvokeVoidAsync("initialize", _canvas, _reference, new
        {
            backgroundTexturePath = EditorSession.BackgroundTexturePath,
            groundTexturePath = EditorSession.GroundTexturePath,
            freeRotationHandlePath = EditorSession.FreeRotationHandlePath,
            definitions = Editor.Definitions.Select(definition => new
            {
                type = definition.Type,
                path = definition.ImagePath,
                yOffset = definition.YOffset
            })
        });
    }

    [JSInvokable]
    public void OnCanvasResized(double width, double height, double left, double top)
    {
        _canvasLeft = left;
        _canvasTop = top;
        Editor.Resize(width, height);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Editor.Changed -= HandleEditorChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }

    private void HandleEditorChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(RenderAsync);
        }
    }

    private async Task RenderAsync()
    {
        if (_module is not null && Editor.Width > 0 && Editor.Height > 0)
        {
            await _module.InvokeVoidAsync("render", _canvas, Editor.CreateRenderSnapshot());
        }
    }

    private void HandlePointerDown(PointerEventArgs eventArgs) =>
        Editor.BeginPointer(eventArgs.PointerId, eventArgs.Button,
            ToCanvasX(eventArgs.ClientX), ToCanvasY(eventArgs.ClientY));

    private void HandlePointerMove(PointerEventArgs eventArgs) =>
        Editor.MovePointer(eventArgs.PointerId,
            ToCanvasX(eventArgs.ClientX), ToCanvasY(eventArgs.ClientY));

    private void HandlePointerUp(PointerEventArgs eventArgs) =>
        Editor.EndPointer(eventArgs.PointerId,
            ToCanvasX(eventArgs.ClientX), ToCanvasY(eventArgs.ClientY));

    private void HandlePointerLeave() => Editor.LeavePointer();

    private void HandleWheel(WheelEventArgs eventArgs)
    {
        if (!eventArgs.CtrlKey)
        {
            Editor.ZoomAt(Math.Exp(-eventArgs.DeltaY * 0.0015), ToCanvasX(eventArgs.ClientX));
        }
    }

    private double ToCanvasX(double clientX) => clientX - _canvasLeft;
    private double ToCanvasY(double clientY) => clientY - _canvasTop;
}
