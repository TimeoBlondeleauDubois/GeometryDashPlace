@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<canvas class="editor-grid"
        @ref="_canvas"
        aria-label="Geometry Dash editor grid"
        tabindex="0"
        @onpointerdown="HandlePointerDown"
        @onpointermove="HandlePointerMove"
        @onpointerup="HandlePointerUp"
        @onpointercancel="HandlePointerCancel"
        @onpointerleave="HandlePointerLeave"
        @onpointerdown:preventDefault="true"
        @onwheel="HandleWheel"
        @onwheel:preventDefault="true"></canvas>

@if (ShowChrome)
{
    <FreeRotationOverlay />
    <ScaleOverlay />
    <LevelTimeline />
    <ZoomControls />
    <EditorStatus />
}

@code {
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<EditorViewport>? _reference;
    private bool _disposed;
    private double _canvasLeft;
    private double _canvasTop;
    private readonly Dictionary<long, TouchPoint> _touchPointers = [];
    private bool _isPinching;
    private double? _pinchDistance;

    [CascadingParameter]
    public required EditorSession Editor { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public bool ShowChrome { get; set; } = true;

    [Parameter]
    public string BackgroundTexturePath { get; set; } = EditorSession.BackgroundTexturePath;

    [Parameter]
    public string GroundTexturePath { get; set; } = EditorSession.GroundTexturePath;

    protected override void OnInitialized()
    {
        Editor.Changed += HandleEditorChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _reference = DotNetObjectReference.Create(this);
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/editor/editor-canvas.js");
        await _module.InvokeVoidAsync("initialize", _canvas, _reference, new
        {
            backgroundTexturePath = BackgroundTexturePath,
            groundTexturePath = GroundTexturePath,
            freeRotationHandlePath = EditorSession.FreeRotationHandlePath,
            definitions = Editor.Definitions.Select(definition => new
            {
                type = definition.Type,
                path = definition.ImagePath,
                yOffset = definition.YOffset
            })
        });
    }

    [JSInvokable]
    public void OnCanvasResized(double width, double height, double left, double top)
    {
        _canvasLeft = left;
        _canvasTop = top;
        Editor.Resize(width, height);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Editor.Changed -= HandleEditorChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _reference?.Dispose();
    }

    private void HandleEditorChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(RenderAsync);
        }
    }

    private async Task RenderAsync()
    {
        if (_module is not null && Editor.Width > 0 && Editor.Height > 0)
        {
            await _module.InvokeVoidAsync("render", _canvas, Editor.CreateRenderSnapshot());
        }
    }

    private void HandlePointerDown(PointerEventArgs eventArgs)
    {
        var x = ToCanvasX(eventArgs.ClientX);
        var y = ToCanvasY(eventArgs.ClientY);
        if (!IsTouch(eventArgs))
        {
            Editor.BeginPointer(eventArgs.PointerId, eventArgs.Button, x, y);
            return;
        }

        _touchPointers[eventArgs.PointerId] = new TouchPoint(x, y);
        if (_touchPointers.Count == 1)
        {
            _isPinching = false;
            Editor.BeginPointer(eventArgs.PointerId, eventArgs.Button, x, y);
            return;
        }

        if (_touchPointers.Count == 2)
        {
            var first = _touchPointers.First(pair => pair.Key != eventArgs.PointerId);
            Editor.EndPointer(first.Key, first.Value.X, first.Value.Y, allowCellClick: false);
            _isPinching = true;
            _pinchDistance = PinchDistance();
        }
    }

    private void HandlePointerMove(PointerEventArgs eventArgs)
    {
        var x = ToCanvasX(eventArgs.ClientX);
        var y = ToCanvasY(eventArgs.ClientY);
        if (!IsTouch(eventArgs) || !_touchPointers.ContainsKey(eventArgs.PointerId))
        {
            Editor.MovePointer(eventArgs.PointerId, x, y);
            return;
        }

        _touchPointers[eventArgs.PointerId] = new TouchPoint(x, y);
        if (!_isPinching || _touchPointers.Count < 2)
        {
            Editor.MovePointer(eventArgs.PointerId, x, y);
            return;
        }

        var distance = PinchDistance();
        if (_pinchDistance is > 0 && distance > 0)
        {
            var factor = Math.Clamp(distance / _pinchDistance.Value, 0.82, 1.22);
            Editor.ZoomAt(factor, PinchCenterX());
        }
        _pinchDistance = distance;
    }

    private void HandlePointerUp(PointerEventArgs eventArgs) =>
        EndPointer(eventArgs, allowCellClick: !ReadOnly);

    private void HandlePointerCancel(PointerEventArgs eventArgs) =>
        EndPointer(eventArgs, allowCellClick: false);

    private void EndPointer(PointerEventArgs eventArgs, bool allowCellClick)
    {
        var x = ToCanvasX(eventArgs.ClientX);
        var y = ToCanvasY(eventArgs.ClientY);
        if (!IsTouch(eventArgs))
        {
            Editor.EndPointer(eventArgs.PointerId, x, y, allowCellClick);
            return;
        }

        if (!_isPinching)
        {
            Editor.EndPointer(eventArgs.PointerId, x, y, allowCellClick);
        }

        _touchPointers.Remove(eventArgs.PointerId);
        if (_touchPointers.Count < 2)
        {
            _pinchDistance = null;
        }
        if (_touchPointers.Count == 0)
        {
            _isPinching = false;
        }
    }

    private void HandlePointerLeave(PointerEventArgs eventArgs)
    {
        if (!IsTouch(eventArgs))
        {
            Editor.LeavePointer();
        }
    }

    private void HandleWheel(WheelEventArgs eventArgs)
    {
        if (!eventArgs.CtrlKey)
        {
            Editor.ZoomAt(Math.Exp(-eventArgs.DeltaY * 0.0015), ToCanvasX(eventArgs.ClientX));
        }
    }

    private double ToCanvasX(double clientX) => clientX - _canvasLeft;
    private double ToCanvasY(double clientY) => clientY - _canvasTop;

    private double PinchDistance()
    {
        var points = _touchPointers.Values.Take(2).ToArray();
        return points.Length < 2
            ? 0
            : Math.Sqrt(
                Math.Pow(points[1].X - points[0].X, 2) +
                Math.Pow(points[1].Y - points[0].Y, 2));
    }

    private double PinchCenterX() => _touchPointers.Values.Take(2).Average(point => point.X);

    private static bool IsTouch(PointerEventArgs eventArgs) =>
        string.Equals(eventArgs.PointerType, "touch", StringComparison.OrdinalIgnoreCase);

    private readonly record struct TouchPoint(double X, double Y);
}
