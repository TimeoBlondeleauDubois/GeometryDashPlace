<div class="confirm-placement-area">
    <button class="confirm-placement-button"
            type="button"
            aria-label="Confirm placement"
            title="Confirm placement"
            disabled="@(!Editor.HasPendingObject)"
            @onclick="Editor.ConfirmPlacement">
        <img src="/assets/ui/editor/confirmation/confirm-checkmark.png"
             alt=""
             aria-hidden="true" />
    </button>
    <small>VALIDER</small>
</div>

@code {
    [CascadingParameter]
    public required EditorSession Editor { get; set; }
}
