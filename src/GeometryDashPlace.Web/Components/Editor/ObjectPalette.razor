@using System.Globalization

<div class="palette-content" hidden="@(Editor.Mode != EditorMode.Build)">
    <button class="palette-navigation palette-navigation-previous"
            type="button"
            disabled="@(Editor.PalettePageCount == 1)"
            aria-label="Previous object page"
            @onclick="Editor.PreviousPalettePage">
        <img src="/assets/ui/editor/navigation/navigation-arrow.png" alt="" draggable="false" />
    </button>

    <div class="object-palette">
        @foreach (var definition in Editor.VisibleDefinitions)
        {
            <button class="object-button @(Editor.IsObjectSelected(definition.Type) ? "is-selected" : null)"
                    type="button"
                    data-object-type="@definition.Type"
                    data-object-name="@definition.Name"
                    data-object-path="@definition.ImagePath"
                    data-object-y-offset="@definition.YOffset.ToString(CultureInfo.InvariantCulture)"
                    data-object-can-rotate="@definition.CanRotate.ToString().ToLowerInvariant()"
                    aria-label="@definition.Name"
                    @onclick="() => Editor.SelectCatalogObject(definition.Type)">
                <span class="object-button-frame"></span>
                <img src="@definition.ImagePath" alt="" draggable="false" />
                @if (definition.Label is not null)
                {
                    <span class="trigger-label" aria-hidden="true">
                        <GeometryDashText Text="@definition.Label" Height="12" />
                    </span>
                }
            </button>
        }
    </div>

    <button class="palette-navigation palette-navigation-next"
            type="button"
            disabled="@(Editor.PalettePageCount == 1)"
            aria-label="Next object page"
            @onclick="Editor.NextPalettePage">
        <img src="/assets/ui/editor/navigation/navigation-arrow.png" alt="" draggable="false" />
    </button>
</div>

@code {
    [CascadingParameter]
    public required EditorSession Editor { get; set; }
}
