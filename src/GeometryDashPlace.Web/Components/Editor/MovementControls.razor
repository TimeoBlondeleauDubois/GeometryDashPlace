<section class="edit-panel @(Editor.HasPendingObject ? "is-active" : null)"
         hidden="@(Editor.Mode != EditorMode.Edit)"
         aria-label="Selected object position">
    <span class="pending-position">
        <GeometryDashText Text="@(Editor.PendingObject is null
            ? "Select a cell"
            : $"Preview: cell {Editor.PendingObject.X}, {Editor.PendingObject.Y}")" Height="15" />
    </span>
    <div class="movement-buttons">
        <button type="button" aria-label="Move up one cell"
                disabled="@(!Editor.CanMovePendingObject(0, 1))"
                @onclick="() => Editor.MovePendingObject(0, 1)">
            <img src="/assets/ui/editor/movement/move-up.png" alt="" draggable="false" />
        </button>
        <button type="button" aria-label="Move down one cell"
                disabled="@(!Editor.CanMovePendingObject(0, -1))"
                @onclick="() => Editor.MovePendingObject(0, -1)">
            <img src="/assets/ui/editor/movement/move-down.png" alt="" draggable="false" />
        </button>
        <button type="button" aria-label="Move left one cell"
                disabled="@(!Editor.CanMovePendingObject(-1, 0))"
                @onclick="() => Editor.MovePendingObject(-1, 0)">
            <img src="/assets/ui/editor/movement/move-left.png" alt="" draggable="false" />
        </button>
        <button type="button" aria-label="Move right one cell"
                disabled="@(!Editor.CanMovePendingObject(1, 0))"
                @onclick="() => Editor.MovePendingObject(1, 0)">
            <img src="/assets/ui/editor/movement/move-right.png" alt="" draggable="false" />
        </button>
        <button class="rotate-object-button"
                type="button"
                title="Rotate 90° counterclockwise"
                aria-label="Rotate object 90 degrees counterclockwise"
                disabled="@(!Editor.CanRotate)"
                @onclick="() => Editor.RotatePendingObject(-90)">
            <img src="/assets/ui/editor/transforms/rotate-counterclockwise.png" alt="" draggable="false" />
        </button>
        <button class="rotate-object-button"
                type="button"
                title="Rotate 90° clockwise"
                aria-label="Rotate object 90 degrees clockwise"
                disabled="@(!Editor.CanRotate)"
                @onclick="() => Editor.RotatePendingObject(90)">
            <img src="/assets/ui/editor/transforms/rotate-clockwise.png" alt="" draggable="false" />
        </button>
        <button class="free-rotation-button @(Editor.FreeRotationEnabled ? "is-selected" : null)"
                type="button"
                title="Free rotation"
                aria-label="Toggle free rotation"
                aria-pressed="@Editor.FreeRotationEnabled"
                disabled="@(!Editor.CanFreeRotate)"
                @onclick="Editor.ToggleFreeRotation">
            <img src="/assets/ui/editor/modes/mode-free-rotate.png" alt="" draggable="false" />
        </button>
        <button class="scale-object-button @(Editor.ScaleModeEnabled ? "is-selected" : null)"
                type="button"
                title="Scale X/Y"
                aria-label="Toggle X and Y scale controls"
                aria-pressed="@Editor.ScaleModeEnabled"
                disabled="@(!Editor.CanScale)"
                @onclick="Editor.ToggleScaleMode">
            <img src="/assets/ui/editor/modes/mode-scale-xy.png" alt="" draggable="false" />
        </button>
    </div>
</section>

@code {
    [CascadingParameter]
    public required EditorSession Editor { get; set; }
}
