@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<section class="level-timeline" aria-label="Quick level navigation">
    <div class="timeline-track"
         @ref="_track"
         role="slider"
         tabindex="0"
         aria-label="Level position"
         aria-valuemin="0"
         aria-valuemax="100"
         aria-valuenow="@Math.Round(Editor.TimelineProgress * 100)"
         style="--timeline-position: @(2.2 + Editor.TimelineProgress * 95.6)%"
         @onpointerdown="HandlePointerDown"
         @onpointermove="HandlePointerMove"
         @onpointerup="HandlePointerUp"
         @onpointercancel="HandlePointerUp"
         @onpointerdown:preventDefault="true"
         @onkeydown="HandleKeyDown">
        <img class="timeline-frame"
             src="/assets/ui/editor/timeline/timeline-track.png"
             alt=""
             draggable="false" />
        <span class="timeline-handle" aria-hidden="true">
            <img src="/assets/ui/editor/timeline/timeline-handle.png"
                 alt=""
                 draggable="false" />
        </span>
    </div>
</section>

@code {
    private ElementReference _track;
    private IJSObjectReference? _module;
    private long? _pointerId;

    [CascadingParameter]
    public required EditorSession Editor { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "/js/editor/dom-interop.js");
            await _module.InvokeVoidAsync("enablePointerCapture", _track);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disablePointerCapture", _track);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private async Task HandlePointerDown(PointerEventArgs eventArgs)
    {
        if (eventArgs.Button != 0 || _module is null)
        {
            return;
        }

        _pointerId = eventArgs.PointerId;
        await UpdateProgress(eventArgs.ClientX);
    }

    private Task HandlePointerMove(PointerEventArgs eventArgs) => _pointerId == eventArgs.PointerId
        ? UpdateProgress(eventArgs.ClientX)
        : Task.CompletedTask;

    private void HandlePointerUp(PointerEventArgs eventArgs)
    {
        if (_pointerId != eventArgs.PointerId)
        {
            return;
        }

        _pointerId = null;
    }

    private async Task UpdateProgress(double clientX)
    {
        if (_module is null)
        {
            return;
        }

        var progress = await _module.InvokeAsync<double>("horizontalProgress", _track, clientX);
        Editor.SetTimelineProgress(progress);
    }

    private void HandleKeyDown(KeyboardEventArgs eventArgs)
    {
        switch (eventArgs.Key)
        {
            case "ArrowLeft":
                Editor.MoveTimelineByCells(-10);
                break;
            case "ArrowRight":
                Editor.MoveTimelineByCells(10);
                break;
            case "PageUp":
                Editor.SetTimelineProgress(Editor.TimelineProgress - 0.1);
                break;
            case "PageDown":
                Editor.SetTimelineProgress(Editor.TimelineProgress + 0.1);
                break;
            case "Home":
                Editor.SetTimelineProgress(0);
                break;
            case "End":
                Editor.SetTimelineProgress(1);
                break;
        }
    }
}
