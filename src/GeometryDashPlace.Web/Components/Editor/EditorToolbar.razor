<section class="object-toolbar" aria-label="Objets à placer">
    <EditorModeTabs />

    <header class="palette-heading">
        <strong>@Editor.SelectedObjectName</strong>
        <small>@Editor.RotationText</small>
    </header>

    <ObjectPalette />
    <MovementControls />
    <ColorTriggerSettings />
    <PlacementConfirmation />

    <div class="palette-pages" hidden="@(Editor.Mode != EditorMode.Build)" aria-live="polite">
        @Editor.PalettePageText
    </div>
</section>

@code {
    [CascadingParameter]
    public required EditorSession Editor { get; set; }
}
