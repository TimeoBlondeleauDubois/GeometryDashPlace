<nav class="editor-mode-tabs" aria-label="Mode de l’éditeur">
    <button class="@(Editor.Mode == EditorMode.Build ? "is-active" : null)"
            type="button"
            aria-pressed="@(Editor.Mode == EditorMode.Build)"
            @onclick="() => Editor.SetMode(EditorMode.Build)">
        <span class="mode-decoration mode-decoration-build" aria-hidden="true"></span>
        <span class="mode-label"><GeometryDashText Text="CREATE" Height="24" /></span>
    </button>
    <button class="@(Editor.Mode == EditorMode.Edit ? "is-active" : null)"
            type="button"
            aria-pressed="@(Editor.Mode == EditorMode.Edit)"
            @onclick="() => Editor.SetMode(EditorMode.Edit)">
        <img class="mode-decoration mode-decoration-edit"
             src="/assets/ui/editor/modes/edit-tools.png"
             alt=""
             aria-hidden="true" />
        <span class="mode-label"><GeometryDashText Text="EDIT" Height="24" /></span>
    </button>
    <DeleteSelection />
</nav>

@code {
    [CascadingParameter]
    public required EditorSession Editor { get; set; }
}
