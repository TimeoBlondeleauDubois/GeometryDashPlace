@using System.Globalization

<span class="geometry-dash-text @(Gold ? "is-gold" : null)" aria-hidden="true">
    @foreach (var character in Text.ToUpperInvariant())
    {
        if (ActiveGlyphs.TryGetValue(character, out var glyph))
        {
            <span class="glyph-slot" style="@GetSlotStyle(glyph)">
                <span class="glyph-image" style="@GetImageStyle(glyph)"></span>
            </span>
        }
    }
</span>

