        ['Z'] = new(363, 237, 49, 53, -1, 10, 40)
    };

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public double Height { get; set; } = 40;

    private double Scale => Height / FontLineHeight;

    private string GetSlotStyle(Glyph glyph) => FormattableString.Invariant(
        $"width:{glyph.Advance * Scale:0.###}px;height:{Height:0.###}px");

    private string GetImageStyle(Glyph glyph) => FormattableString.Invariant(
        $"left:{glyph.OffsetX * Scale:0.###}px;top:{glyph.OffsetY * Scale:0.###}px;width:{glyph.Width * Scale:0.###}px;height:{glyph.Height * Scale:0.###}px;background-size:{TextureSize * Scale:0.###}px {TextureSize * Scale:0.###}px;background-position:{-glyph.X * Scale:0.###}px {-glyph.Y * Scale:0.###}px");

    private sealed record Glyph(
        int X,
        int Y,
        int Width,
        int Height,
        int OffsetX,
        int OffsetY,
        int Advance);
}
