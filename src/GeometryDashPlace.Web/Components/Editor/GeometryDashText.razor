    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public double Height { get; set; } = 40;

    [Parameter]
    public bool Gold { get; set; }

    private IReadOnlyDictionary<char, Glyph> ActiveGlyphs => Gold ? GoldGlyphs : Glyphs;
    private double ActiveLineHeight => Gold ? GoldFontLineHeight : DefaultFontLineHeight;
    private double ActiveTextureSize => Gold ? GoldTextureSize : DefaultTextureSize;
    private string ActiveTexturePath => Gold
        ? "/assets/ui/fonts/geometry-dash-gold.png"
        : "/assets/ui/fonts/geometry-dash-big.png";
    private double Scale => Height / ActiveLineHeight;

    private string GetSlotStyle(Glyph glyph) => FormattableString.Invariant(
        $"width:{glyph.Advance * Scale:0.###}px;height:{Height:0.###}px");

    private string GetImageStyle(Glyph glyph) => FormattableString.Invariant(
        $"left:{glyph.OffsetX * Scale:0.###}px;top:{glyph.OffsetY * Scale:0.###}px;width:{glyph.Width * Scale:0.###}px;height:{glyph.Height * Scale:0.###}px;background-image:url('{ActiveTexturePath}');background-size:{ActiveTextureSize * Scale:0.###}px {ActiveTextureSize * Scale:0.###}px;background-position:{-glyph.X * Scale:0.###}px {-glyph.Y * Scale:0.###}px");

    private sealed record Glyph(
        int X,
        int Y,
        int Width,
        int Height,
        int OffsetX,
        int OffsetY,
        int Advance);
