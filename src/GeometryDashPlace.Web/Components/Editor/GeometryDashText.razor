@using System.Globalization

<span class="geometry-dash-text" aria-hidden="true">
    @foreach (var character in Text.ToUpperInvariant())
    {
        if (Glyphs.TryGetValue(character, out var glyph))
        {
            <span class="glyph-slot" style="@GetSlotStyle(glyph)">
                <span class="glyph-image" style="@GetImageStyle(glyph)"></span>
            </span>
        }
    }
</span>

@code {
    private const double FontLineHeight = 67;
    private const double TextureSize = 512;

    private static readonly IReadOnlyDictionary<char, Glyph> Glyphs = new Dictionary<char, Glyph>
    {
        [' '] = new(0, 0, 0, 0, 0, 63, 30),
        ['#'] = new(1, 443, 56, 33, -1, 10, 47),
        ['%'] = new(326, 1, 63, 57, -1, 8, 54),
        ['('] = new(128, 1, 29, 66, -1, 3, 20),
        [')'] = new(158, 1, 29, 66, -1, 3, 20),
        [','] = new(155, 443, 25, 29, -1, 39, 16),
        ['-'] = new(392, 443, 35, 22, -1, 28, 26),
        ['.'] = new(326, 443, 23, 23, -1, 41, 14),
        ['/'] = new(1, 69, 35, 56, 0, 9, 27),
        ['0'] = new(363, 69, 51, 55, -1, 9, 42),
        ['1'] = new(461, 237, 42, 53, -1, 10, 33),
        ['2'] = new(319, 126, 50, 54, -1, 9, 41),
        ['3'] = new(415, 69, 50, 55, -1, 9, 41),
        ['4'] = new(144, 182, 56, 53, -1, 10, 47),
        ['5'] = new(370, 126, 49, 54, -1, 9, 40),
        ['6'] = new(259, 69, 51, 55, -1, 9, 43),
        ['7'] = new(212, 237, 50, 53, -1, 10, 41),
        ['8'] = new(420, 126, 48, 54, -1, 10, 39),
        ['9'] = new(311, 69, 51, 55, -1, 9, 42),
        [':'] = new(285, 291, 25, 49, -1, 15, 16),
        ['A'] = new(95, 126, 56, 54, -1, 9, 47),
        ['B'] = new(1, 237, 52, 53, -1, 10, 43),
        ['C'] = new(94, 69, 55, 55, -1, 9, 46),
        ['D'] = new(54, 237, 52, 53, -1, 10, 43),
        ['E'] = new(263, 237, 49, 53, -1, 10, 40),
        ['F'] = new(313, 237, 49, 53, -1, 10, 40),
        ['G'] = new(150, 69, 55, 55, -1, 9, 46),
        ['H'] = new(87, 182, 56, 53, -1, 10, 47),
        ['I'] = new(1, 291, 33, 53, -1, 11, 24),
        ['J'] = new(469, 126, 39, 54, -1, 10, 30),
        ['K'] = new(423, 182, 53, 53, -1, 11, 44),
        ['L'] = new(413, 237, 47, 53, -1, 10, 38),
        ['M'] = new(27, 182, 59, 53, -1, 11, 50),
        ['N'] = new(160, 237, 51, 53, -1, 10, 42),
        ['O'] = new(37, 69, 56, 55, -1, 9, 47),
        ['P'] = new(313, 182, 54, 53, -1, 10, 45),
        ['Q'] = new(390, 1, 56, 57, -1, 10, 47),
        ['R'] = new(368, 182, 54, 53, -1, 11, 45),
        ['S'] = new(206, 69, 52, 55, -1, 9, 43),
        ['T'] = new(107, 237, 52, 53, -1, 11, 43),
        ['U'] = new(265, 126, 53, 54, -1, 10, 44),
        ['V'] = new(201, 182, 55, 53, -1, 11, 46),
