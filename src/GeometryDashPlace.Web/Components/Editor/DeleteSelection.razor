<div class="delete-selection-area" data-delete-selection-area>
    <button class="delete-selection-button @(Editor.Mode == EditorMode.Delete ? "is-active" : null)"
            type="button"
            data-editor-action="delete-selection"
            aria-label="Delete mode"
            title="Delete mode"
            aria-pressed="@(Editor.Mode == EditorMode.Delete)"
            @onclick="() => Editor.SetMode(EditorMode.Delete)">
        <img class="delete-selection-decoration"
             src="/assets/ui/editor/actions/delete-object.png"
             alt=""
             aria-hidden="true"
             draggable="false" />
        <span class="delete-selection-label"><GeometryDashText Text="DELETE" Height="22" /></span>
    </button>
</div>

@code {
    [CascadingParameter]
    public required EditorSession Editor { get; set; }
}
