@using GeometryDashPlace.Web.Events
@implements IAsyncDisposable

@EventCountdown.Detailed(StartsAt, _now)

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private DateTimeOffset _trackedStart;
    private Task? _timerTask;
    private bool _elapsedRaised;

    [Parameter, EditorRequired]
    public DateTimeOffset StartsAt { get; set; }

    [Parameter]
    public EventCallback Elapsed { get; set; }

    protected override void OnInitialized()
    {
        _trackedStart = StartsAt;
        _timerTask = RunTimerAsync(_cancellation.Token);
    }

    protected override void OnParametersSet()
    {
        if (_trackedStart == StartsAt)
        {
            return;
        }

        _trackedStart = StartsAt;
        _elapsedRaised = false;
        _now = DateTimeOffset.UtcNow;
    }

    public async ValueTask DisposeAsync()
    {
        await _cancellation.CancelAsync();
        if (_timerTask is not null)
        {
            try
            {
                await _timerTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        _cancellation.Dispose();
    }

    private async Task RunTimerAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            await InvokeAsync(async () =>
            {
                _now = DateTimeOffset.UtcNow;
                if (!_elapsedRaised && _now >= StartsAt)
                {
                    _elapsedRaised = true;
                    await Elapsed.InvokeAsync();
                }
                StateHasChanged();
            });
        }
    }
}
