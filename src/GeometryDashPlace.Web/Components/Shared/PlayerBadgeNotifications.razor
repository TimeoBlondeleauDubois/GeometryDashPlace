@using GeometryDashPlace.Web.Auth
@using GeometryDashPlace.Web.Events
@using GeometryDashPlace.Web.Profiles
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IPlayerBadgeService Badges
@inject PlayerBadgeNotificationDispatcher Notifications
@inject EventLifecycleNotifier EventLifecycle
@inject ILogger<PlayerBadgeNotifications> Logger

@if (_activeBadge is not null)
{
    <aside class="badge-unlock" role="status" aria-live="assertive">
        <button class="badge-unlock-close" type="button" aria-label="Close" @onclick="DismissAsync">×</button>
        <div class="badge-unlock-rays" aria-hidden="true"></div>
        <div class="badge-unlock-medal" aria-hidden="true">&#9733;</div>
        <div class="badge-unlock-copy">
            <GeometryDashText Text="BADGE UNLOCKED" Height="21" Gold="true" />
            <GeometryDashText Text="@_activeBadge.Name" Height="17" />
            <p>@_activeBadge.Description</p>
        </div>
    </aside>
}

@code {
    private static readonly TimeSpan DisplayDuration = TimeSpan.FromSeconds(5);
    private readonly Queue<PlayerBadgeNotification> _queue = [];
    private readonly HashSet<string> _queuedReferences = new(StringComparer.Ordinal);
    private readonly CancellationTokenSource _lifetime = new();
    private IDisposable? _notificationSubscription;
    private IDisposable? _eventLifecycleSubscription;
    private PlayerBadgeNotification? _activeBadge;
    private Guid? _userId;
    private long _displayVersion;

    protected override async Task OnInitializedAsync()
    {
        _notificationSubscription = Notifications.Subscribe(HandleNotificationsAsync);
        _eventLifecycleSubscription = EventLifecycle.Subscribe(RefreshPendingAsync);

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (AuthenticatedUser.TryGetUserId(authenticationState.User, out var userId))
            {
                _userId = userId;
                await EnqueueAsync(await Badges.GetPendingAsync(userId, _lifetime.Token));
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to load pending badge notifications.");
        }
    }

    public void Dispose()
    {
        _notificationSubscription?.Dispose();
        _eventLifecycleSubscription?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private Task HandleNotificationsAsync(IReadOnlyList<PlayerBadgeNotification> badges) =>
        InvokeAsync(() => EnqueueAsync(badges));

    private Task RefreshPendingAsync() => InvokeAsync(async () =>
    {
        if (_userId is { } userId)
        {
            await EnqueueAsync(await Badges.GetPendingAsync(userId, _lifetime.Token));
        }
    });

    private async Task EnqueueAsync(IReadOnlyList<PlayerBadgeNotification> badges)
    {
        if (_userId is null || badges.Count == 0)
        {
            return;
        }

        var newlyQueued = badges
            .Where(badge => _queuedReferences.Add(Reference(badge)))
            .ToArray();
        if (newlyQueued.Length == 0)
        {
            return;
        }

        foreach (var badge in newlyQueued)
        {
            _queue.Enqueue(badge);
        }

        ShowNext();
    }

    private void ShowNext()
    {
        if (_activeBadge is not null || !_queue.TryDequeue(out var next))
        {
            return;
        }

        _activeBadge = next;
        var version = ++_displayVersion;
        StateHasChanged();
        _ = AcknowledgeAsync(next);
        _ = DismissLaterAsync(version);
    }

    private async Task AcknowledgeAsync(PlayerBadgeNotification badge)
    {
        if (_userId is not { } userId)
        {
            return;
        }

        try
        {
            await Badges.MarkSeenAsync(
                userId,
                [new PlayerBadgeReference(badge.Key, badge.ScopeKey)],
                _lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to acknowledge a badge notification.");
        }
    }

    private async Task DismissLaterAsync(long version)
    {
        try
        {
            await Task.Delay(DisplayDuration, _lifetime.Token);
            await InvokeAsync(async () =>
            {
                if (version == _displayVersion)
                {
                    await DismissAsync();
                }
            });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
    }

    private Task DismissAsync()
    {
        _activeBadge = null;
        _displayVersion++;
        ShowNext();
        return Task.CompletedTask;
    }

    private static string Reference(PlayerBadgeNotification badge) =>
        $"{badge.Key}\n{badge.ScopeKey}";
}
