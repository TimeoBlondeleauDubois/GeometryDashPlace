@using GeometryDashPlace.Web.Auth
@using GeometryDashPlace.Web.Profiles
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserProfileService Profiles

<details class="site-menu">
    <summary class="site-menu-toggle" aria-label="Toggle account and navigation menu">
        <span></span>
        <span></span>
        <span></span>
    </summary>
    <aside class="site-account-panel" aria-label="Account and navigation">
        <span class="site-menu-heading">
            <GeometryDashText Text="MENU" Height="19" Gold="true" />
        </span>
        <a class="site-menu-action site-home-action" href="/">
            <GeometryDashText Text="GEOMETRY DASH PLACE" Height="13" />
        </a>
        <a class="site-menu-action site-events-action" href="/events">
            <GeometryDashText Text="EVENTS" Height="14" />
        </a>
        <AuthorizeView Policy="Admin">
            <a class="site-menu-action site-admin-action" href="/admin">
                <GeometryDashText Text="ADMIN" Height="14" />
            </a>
        </AuthorizeView>
        <AuthorizeView Context="account">
            <Authorized>
                <div class="site-account-identity" title="@account.User.Identity?.Name">
                    @if (!string.IsNullOrWhiteSpace(_profile?.AvatarUrl))
                    {
                        <img class="site-account-avatar"
                             src="@_profile.AvatarUrl"
                             alt=""
                             referrerpolicy="no-referrer" />
                    }
                    else
                    {
                        <span class="site-account-avatar site-account-avatar-default" aria-hidden="true">
                            @AccountInitial
                        </span>
                    }
                    <span class="site-account-name">
                        @(_profile?.Username ?? account.User.Identity?.Name)
                    </span>
                </div>
                <a class="site-menu-action site-profile-action" href="@ProfileUrl">
                    <GeometryDashText Text="EDIT PROFILE" Height="13" />
                </a>
                <a class="site-menu-action site-switch-account-action"
                   href="@LoginUrl"
                   data-enhance-nav="false">
                    <GeometryDashText Text="CHANGE GOOGLE ACCOUNT" Height="12" />
                </a>
                <a class="site-menu-action"
                   href="@LogoutUrl"
                   data-enhance-nav="false">
                    <GeometryDashText Text="LOG OUT" Height="14" />
                </a>
            </Authorized>
            <NotAuthorized>
                <span class="site-account-hint">Sign in to take part in an event.</span>
                <a class="site-menu-action"
                   href="@LoginUrl"
                   data-enhance-nav="false">
                    <GeometryDashText Text="SIGN IN WITH GOOGLE" Height="13" />
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </aside>
</details>

@code {
    private UserProfile? _profile;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthenticatedUser.TryGetUserId(authenticationState.User, out var userId))
        {
            _profile = await Profiles.GetAsync(userId);
        }
    }

    private string LoginUrl =>
        $"/login/google?returnUrl={Uri.EscapeDataString(CurrentReturnUrl)}";

    private string LogoutUrl =>
        $"/logout?returnUrl={Uri.EscapeDataString(CurrentReturnUrl)}";

    private string ProfileUrl =>
        $"/profile/setup?returnUrl={Uri.EscapeDataString(CurrentReturnUrl)}";

    private string CurrentReturnUrl
    {
        get
        {
            var relativeUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (string.IsNullOrWhiteSpace(relativeUrl))
            {
                return "/";
            }

            var localUrl = $"/{relativeUrl}";
            return localUrl.StartsWith("/admin", StringComparison.OrdinalIgnoreCase)
                ? "/events"
                : localUrl;
        }
    }

    private string AccountInitial
    {
        get
        {
            var name = _profile?.Username ?? _profile?.GoogleDisplayName;
            return string.IsNullOrWhiteSpace(name)
                ? "?"
                : name.Trim()[0].ToString().ToUpperInvariant();
        }
    }

}
